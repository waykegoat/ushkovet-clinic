# Comma-separated emails that may access /admin.
ADMIN_EMAILS=owner@example.com

# Generate with: npm run auth:hash -- "your-long-password"
ADMIN_PASSWORD_HASH=

# Random value at least 32 characters long. Keep it only in hosting secrets.
SESSION_SECRET=

ENVIRONMENT=development

# Leave empty when frontend and API share one domain.
VITE_API_BASE_URL=
VITE_STATIC_DEMO=false
